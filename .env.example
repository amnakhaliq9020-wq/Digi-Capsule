# Copy to .env with: npm run init-env
# Never commit .env. The values below are local defaults, not production secrets.

NODE_ENV=development
# development, staging, or production. Staging must use its own database name.
APP_ENV=development

# PostgreSQL from docker compose. Change the host if Postgres runs elsewhere.
DATABASE_URL=postgresql://digi:digi@localhost:5432/digi_capsule

API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Used by the Next.js dev server to proxy /v1 to the API. Not a secret.
API_INTERNAL_URL=http://127.0.0.1:3001

# 32-byte key, base64. npm run init-env replaces the placeholder.
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64

# Development-only simulated clock and test console.
# Ignored when NODE_ENV=production. Never enable this on a shared server.
DIGI_TEST_MODE=true

# Death-related content delivery. Forced off when NODE_ENV=production.
VERIFICATION_RELEASES_ENABLED=false

# local or s3
STORAGE_DRIVER=local
# Relative to the API process working directory (apps/api when using npm workspaces).
LOCAL_STORAGE_DIR=./var/storage

# Optional S3-compatible storage. Leave blank to keep the local adapter.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

MAX_PHOTO_BYTES=15728640
MAX_VIDEO_BYTES=104857600

# Optional SMTP. Leave the server fields blank to keep notices in the local console log.
# Port 465 uses implicit TLS. Port 587 uses STARTTLS.
# SMTP_FROM is the official sender. It is not a test recipient, and it does not fall back to SMTP_USERNAME.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@izzyai.com
# Comma-separated accounts that may view and change SMTP settings. Not a recipient list.
ADMIN_EMAILS=

# Optional Twilio SMS. Leave blank to keep SMS off. Do not put real secrets in this example.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TEST_NUMBER=

# Structured logs. Leave LOG_DIR empty to write only to the process output.
LOG_LEVEL=warn
LOG_DIR=
# Staging backups live outside the database. Ignored by Git via var/.
STAGING_BACKUP_DIR=./var/backups/staging
STAGING_BACKUP_RETENTION=14

# Seed creates a synthetic demo account only when this is true.
SEED_DEMO=false
SEED_DEMO_PASSWORD=Change-Me-Demo-1
SEED_DEMO_EMAIL=demo.author@example.test
