generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account owner. Contacts never store this person's password.
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  /// When the owner last confirmed they are reachable. A missed date does not release memories.
  lastCheckInAt  DateTime?
  contacts       Contact[]
  capsules     Capsule[]
  memories     MemoryItem[]
  mediaAssets  MediaAsset[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// People connected to a capsule are not one role.
/// RECIPIENT may receive memories. This product manages at most two recipient slots.
/// TRUSTED_CONTACT is a separate trust relationship, not a memory recipient.
/// VERIFIER is a separate confirmation role, not a memory recipient.
model Contact {
  id        String      @id @default(cuid())
  ownerId   String
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fullName  String
  email     String
  phone     String?
  role      ContactRole @default(RECIPIENT)
  slot      Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([ownerId, role, slot])
  @@unique([ownerId, role, email])
  @@index([ownerId])
}

enum ContactRole {
  RECIPIENT
  TRUSTED_CONTACT
  VERIFIER
}

/// A capsule is the container. It is not itself a letter, photo, or other memory.
model Capsule {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  memories    MemoryItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
}

/// A memory item belongs to one capsule. Saving one never releases or sends it.
/// SCHEDULED and RELEASED exist so the product can name those states, but a
/// database check keeps every row DRAFT while release is switched off.
model MemoryItem {
  id          String       @id @default(cuid())
  capsuleId   String
  capsule     Capsule      @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        MemoryType
  body        String?
  tags        String[]     @default([])
  status      MemoryStatus @default(DRAFT)
  assets      MediaAsset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
  @@index([capsuleId])
  @@index([ownerId, createdAt])
}

/// Private file metadata. storageKey is an internal path, never a public URL.
model MediaAsset {
  id           String      @id @default(cuid())
  memoryItemId String?
  memoryItem   MemoryItem? @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String      @unique
  kind         MemoryType
  createdAt    DateTime    @default(now())

  @@index([ownerId])
  @@index([memoryItemId])
}

enum MemoryType {
  LETTER
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
}

enum MemoryStatus {
  DRAFT
  SCHEDULED
  RELEASED
}
