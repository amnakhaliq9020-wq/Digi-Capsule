# Copy to .env.staging. Never commit .env.staging.
# These values point only at the staging database on port 5433.

APP_ENV=staging
NODE_ENV=production
DATABASE_URL=postgresql://digi_staging:digi_staging@localhost:5433/digi_capsule_staging
STAGING_DATABASE_URL=postgresql://digi_staging:digi_staging@localhost:5433/digi_capsule_staging

API_HOST=0.0.0.0
API_PORT=3101
WEB_ORIGIN=http://localhost:3100
API_INTERNAL_URL=http://127.0.0.1:3101

# Generate a staging-only key. Do not reuse the development or production key.
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64

DIGI_TEST_MODE=false
VERIFICATION_RELEASES_ENABLED=false

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/staging-storage

SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@izzyai.com
ADMIN_EMAILS=staging.admin@example.test

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TEST_NUMBER=

LOG_LEVEL=info
LOG_DIR=./var/log/staging
STAGING_BACKUP_DIR=./var/backups/staging
STAGING_BACKUP_RETENTION=14
STAGING_POSTGRES_CONTAINER=digi-staging-postgres
STAGING_DB_USER=digi_staging
STAGING_SEED_PASSWORD=Staging-Only-1
